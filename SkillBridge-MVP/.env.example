# SkillBridge Environment Configuration Example
# Copy this file to .env and change the values for your environment.
# NEVER commit your real production secret keys to version control.

# Secret key used for signing JWT authentication tokens
SECRET_KEY=skillbridge-dev-secret-key-change-in-production-123456789

# Algorithm used for JWT encoding (HS256 is standard)
ALGORITHM=HS256

# How long an access token remains valid (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
